# Track badges
msgid "recording…"
msgstr "en cours…"

msgid "already recorded"
msgstr "déjà enregistré"

msgid "error"
msgstr "erreur"

msgid "partial"
msgstr "incomplet"

msgid "too short"
msgstr "trop court"

msgid "bit-perfect {}-bit"
msgstr "bit-perfect {} bits"

msgid "slightly changed by Spotify"
msgstr "légèrement modifié par Spotify"

msgid "peaks limited by Spotify"
msgstr "crêtes limitées par Spotify"

msgid "altered"
msgstr "modifié"

# Header and now playing
msgid "⚙ Settings"
msgstr "⚙ Réglages"

msgid "Spotify is not running"
msgstr "Spotify n'est pas lancé"

msgid "Advertisement"
msgstr "Publicité"

msgid "Nothing playing"
msgstr "Aucune lecture"

msgid "▶ Playing"
msgstr "▶ Lecture"

msgid "⏸ Paused"
msgstr "⏸ En pause"

msgid "Ad, not recorded"
msgstr "Pub, non enregistrée"

msgid "Spotify is open"
msgstr "Spotify est ouvert"

msgid "Start Spotify to record"
msgstr "Lancez Spotify pour enregistrer"

# Notices
msgid "⚠ Windows audio enhancements may be on for \"{}\": recordings would not be lossless. Settings → Sound → that device → Audio enhancements → Off."
msgstr "⚠ Les améliorations audio de Windows sont peut-être actives sur « {} » : les enregistrements ne seraient pas sans perte. Paramètres → Son → ce périphérique → Améliorations audio → Désactivé."

msgid "⚠ \"{}\" runs at {} Hz. Set it to 44100 Hz (Settings → Sound → that device → Format) for lossless recordings."
msgstr "⚠ « {} » fonctionne à {} Hz. Réglez-le sur 44100 Hz (Paramètres → Son → ce périphérique → Format) pour enregistrer sans perte."

msgid "⚠ No virtual cable installed: Spotify stays on its device. Install VB-Cable or turn the option off in the settings."
msgstr "⚠ Aucun câble virtuel installé : Spotify reste sur son périphérique. Installez VB-Cable ou désactivez l'option dans les réglages."

msgid "⚠ The virtual cable is the Windows default output device: nothing can be heard."
msgstr "⚠ Le câble virtuel est le périphérique de sortie par défaut de Windows : plus rien ne s'entend."

msgid "Use \"{}\" again"
msgstr "Revenir à « {} »"

# Recording
msgid "Finishing the last track…"
msgstr "Finalisation du dernier morceau…"

msgid "■  Stop recording"
msgstr "■  Arrêter l'enregistrement"

msgid "●  Start recording"
msgstr "●  Démarrer l'enregistrement"

msgid "This session · {} saved"
msgstr "Cette session · {} enregistrés"

msgid "Open folder"
msgstr "Ouvrir le dossier"

msgid "Waiting for the next track…"
msgstr "En attente du prochain morceau…"

msgid "Recorded tracks will appear here."
msgstr "Les morceaux enregistrés apparaîtront ici."

# Settings panel
msgid "Settings"
msgstr "Réglages"

msgid "Recording"
msgstr "Enregistrement"

msgid "Folder"
msgstr "Dossier"

msgid "Spotify quality"
msgstr "Qualité Spotify"

msgid "Free (160 kbps)"
msgstr "Gratuit (160 kbps)"

msgid "Premium (320 kbps)"
msgstr "Premium (320 kbps)"

msgid "Lossless (FLAC)"
msgstr "Lossless (FLAC)"

msgid "Format"
msgstr "Format"

msgid "FLAC, depth of the source"
msgstr "FLAC, profondeur de la source"

msgid "WAV, depth of the source"
msgstr "WAV, profondeur de la source"

msgid "Shortest track kept (s)"
msgstr "Durée minimale gardée (s)"

msgid "Keep incomplete tracks"
msgstr "Garder les morceaux incomplets"

msgid "Started before the recording, or skipped before the end."
msgstr "Pris en cours de route, ou passés avant la fin."

msgid "Files"
msgstr "Fichiers"

msgid "Sub-folders"
msgstr "Sous-dossiers"

msgid "None"
msgstr "Aucun"

msgid "Artist"
msgstr "Artiste"

msgid "Artist / Album"
msgstr "Artiste / Album"

msgid "Before the name"
msgstr "Devant le nom"

msgid "Nothing"
msgstr "Rien"

msgid "Track number (04)"
msgstr "Numéro de piste (04)"

msgid "Recording order (001)"
msgstr "Ordre d'enregistrement (001)"

msgid "Already recorded"
msgstr "Déjà enregistré"

msgid "Skip it"
msgstr "Le passer"

msgid "Replace it"
msgstr "Le remplacer"

msgid "Keep both"
msgstr "Garder les deux"

msgid "Make Spotify skip tracks already recorded"
msgstr "Faire passer à Spotify les morceaux déjà enregistrés"

msgid "Audio output"
msgstr "Sortie audio"

msgid "Play Spotify through a virtual cable"
msgstr "Faire passer Spotify par un câble virtuel"

msgid "Hear Spotify while recording"
msgstr "Entendre Spotify pendant l'enregistrement"

msgid "Get VB-Cable…"
msgstr "Télécharger VB-Cable…"

msgid "Ads (Spotify Free)"
msgstr "Publicités (Spotify Gratuit)"

msgid "Mute Spotify during ads"
msgstr "Couper le son de Spotify pendant les pubs"

msgid "Interface"
msgstr "Interface"

msgid "Language"
msgstr "Langue"

msgid "For lossless recordings: Spotify in Lossless quality, its volume at maximum, normalization, equalizer, crossfade and Automix off; Windows audio enhancements off and the output device at 44100 Hz. Each saved track says whether it came out bit-perfect."
msgstr "Pour enregistrer sans perte : Spotify en qualité Lossless, volume au maximum, normalisation, égaliseur, fondu enchaîné et Automix désactivés ; améliorations audio de Windows désactivées et périphérique de sortie à 44100 Hz. Chaque morceau enregistré indique s'il est sorti bit-perfect."

msgid "⚠ \"{}\" starts with a fade Spotify added: crossfade or Automix is on, and track changes are not lossless. Spotify → Settings → Playback → turn Crossfade and Automix off."
msgstr "⚠ « {} » commence par un fondu ajouté par Spotify : le fondu enchaîné ou Automix est activé, et les changements de morceau ne sont pas sans perte. Spotify → Paramètres → Lecture → désactivez Fondu enchaîné et Automix."

# Playlist mode
msgid "Spotify playlist or album link"
msgstr "Lien de playlist ou d'album Spotify"

msgid "Record it"
msgstr "Enregistrer"

msgid "■  Stop the playlist"
msgstr "■  Arrêter la playlist"

msgid "{} · {} / {}"
msgstr "{} · {} / {}"

msgid "Retry the {} missed"
msgstr "Réessayer les {} manquants"

msgid "⏸ Paused: press play in Spotify"
msgstr "⏸ En pause : lancez la lecture dans Spotify"

msgid "Play something in Spotify"
msgstr "Lancez une lecture dans Spotify"

msgid "⚠ Spotify's volume normalization is on: it changes the sound. Spotify → Settings → Playback → Normalize volume → off."
msgstr "⚠ La normalisation du volume de Spotify est activée : elle modifie le son. Spotify → Paramètres → Lecture → Normaliser le volume → désactivé."

msgid "⚠ Spotify's Automix is on: it mixes the transitions of playlists. Spotify → Settings → Playback → Automix → off."
msgstr "⚠ Automix de Spotify est activé : il mixe les transitions des playlists. Spotify → Paramètres → Lecture → Automix → désactivé."

msgid "⚠ Spotify does not stream in Lossless. Spotify → Settings → Audio quality → Lossless, or set the Spotify quality in Resona's settings."
msgstr "⚠ Spotify ne lit pas en Lossless. Spotify → Paramètres → Qualité audio → Lossless, ou changez la qualité Spotify dans les réglages de Resona."

msgid "⚠ Tracks altered on their way out of Spotify: {} (last: \"{}\"). Check Spotify's volume and the audio settings."
msgstr "⚠ Morceaux modifiés entre Spotify et l'enregistrement : {} (dernier : « {} »). Vérifiez le volume de Spotify et les réglages audio."

msgid "⚠ Spotify's volume is at {} %: recordings are scaled down and not lossless."
msgstr "⚠ Le volume de Spotify est à {} % : les enregistrements sont atténués et ne sont pas sans perte."

msgid "Set Spotify to 100 %"
msgstr "Mettre Spotify à 100 %"

# Updates
msgid "Resona {} is available."
msgstr "Resona {} est disponible."

msgid "Download it"
msgstr "La télécharger"

msgid "Check for updates at launch"
msgstr "Rechercher les mises à jour au lancement"

# Errors
msgid "⚠ Spotify is not running: start it, then try again."
msgstr "⚠ Spotify n'est pas lancé : lancez-le, puis réessayez."

msgid "⚠ Spotify's command-line tool (spotify_cli) is missing: playlist mode, exact tags and the volume check need a recent Spotify build."
msgstr "⚠ L'outil en ligne de commande de Spotify (spotify_cli) est absent : le mode playlist, les tags exacts et la vérification du volume demandent une version récente de Spotify."

msgid "⚠ Spotify did not carry out the request."
msgstr "⚠ Spotify n'a pas exécuté la demande."

msgid "⚠ This is not a Spotify playlist, album or track link."
msgstr "⚠ Ce n'est pas un lien de playlist, d'album ou de morceau Spotify."

msgid "⚠ Spotify did not start the playlist. Check that it is open and logged in, then try again."
msgstr "⚠ Spotify n'a pas lancé la playlist. Vérifiez qu'il est ouvert et connecté, puis réessayez."

msgid "⚠ Spotify stopped answering: the playlist was stopped."
msgstr "⚠ Spotify ne répond plus : la playlist a été arrêtée."

msgid "⚠ The capture did not start: is Spotify running on this computer?"
msgstr "⚠ La capture n'a pas démarré : Spotify tourne-t-il bien sur cet ordinateur ?"

msgid "⚠ Spotify does not know this track."
msgstr "⚠ Spotify ne connaît pas ce morceau."

msgid "⚠ Spotify could not be sent to the virtual cable: it stays on its device."
msgstr "⚠ Spotify n'a pas pu être envoyé vers le câble virtuel : il reste sur son périphérique."

msgid "⚠ Spotify could not be played back on the headset."
msgstr "⚠ Le son de Spotify n'a pas pu être rejoué dans le casque."

msgid "⚠ \"{}\" could not be saved."
msgstr "⚠ « {} » n'a pas pu être enregistré."

msgid "⚠ The default output device could not be changed."
msgstr "⚠ Le périphérique de sortie par défaut n'a pas pu être changé."

msgid "⚠ Something went wrong."
msgstr "⚠ Une erreur s'est produite."

# Settings navigation
msgid "Audio"
msgstr "Audio"

msgid "Changes are saved automatically"
msgstr "Les modifications sont enregistrées automatiquement"

msgid "Install VB-Cable to isolate recordings from your headset settings."
msgstr "Installez VB-Cable pour isoler les enregistrements des réglages du casque."

msgid "Records independently of your headset. Enable monitoring below to listen."
msgstr "Enregistrement indépendant du casque. Activez l’écoute ci-dessous pour entendre Spotify."

msgid "Hide audio tips"
msgstr "Masquer les conseils audio"

msgid "Tips for lossless audio"
msgstr "Conseils pour un son sans perte"

msgid "Your music, saved here"
msgstr "Votre musique, à retrouver ici"

# Lyrics
msgid "Save lyrics next to each track (.lrc)"
msgstr "Enregistrer les paroles à côté de chaque morceau (.lrc)"

msgid "From LRCLIB, an open lyrics database: synced when it has the timing, plain otherwise."
msgstr "Depuis LRCLIB, une base de paroles ouverte : synchronisées quand elle a le minutage, simples sinon."
