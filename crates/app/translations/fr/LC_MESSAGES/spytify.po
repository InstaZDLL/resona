# Track badges
msgid "recording…"
msgstr "en cours…"

msgid "already recorded"
msgstr "déjà enregistré"

msgid "error"
msgstr "erreur"

msgid "partial"
msgstr "incomplet"

msgid "too short"
msgstr "trop court"

msgid "bit-perfect {}-bit"
msgstr "bit-perfect {} bits"

msgid "near-lossless 24-bit"
msgstr "quasi sans perte, 24 bits"

msgid "peaks limited by Spotify"
msgstr "crêtes limitées par Spotify"

msgid "altered"
msgstr "modifié"

# Header and now playing
msgid "⚙ Settings"
msgstr "⚙ Réglages"

msgid "Spotify is not running"
msgstr "Spotify n'est pas lancé"

msgid "Advertisement"
msgstr "Publicité"

msgid "Nothing playing"
msgstr "Aucune lecture"

msgid "▶ Playing"
msgstr "▶ Lecture"

msgid "⏸ Paused"
msgstr "⏸ En pause"

msgid "Ad, not recorded"
msgstr "Pub, non enregistrée"

msgid "Spotify is open"
msgstr "Spotify est ouvert"

msgid "Start Spotify to record"
msgstr "Lancez Spotify pour enregistrer"

# Notices
msgid "⚠ Windows audio enhancements may be on: recordings would not be lossless. Settings → Sound → your device → Audio enhancements → Off."
msgstr "⚠ Les améliorations audio de Windows sont peut-être actives : les enregistrements ne seraient pas sans perte. Paramètres → Son → votre périphérique → Améliorations audio → Désactivé."

msgid "⚠ Your output device runs at {} Hz. Set it to 44100 Hz (Settings → Sound → your device → Format) for lossless recordings."
msgstr "⚠ Votre périphérique de sortie fonctionne à {} Hz. Réglez-le sur 44100 Hz (Paramètres → Son → votre périphérique → Format) pour enregistrer sans perte."

msgid "⚠ \"{}\" was altered on its way out of Spotify (effect, resampling or volume). Check the audio settings."
msgstr "⚠ « {} » a été modifié entre Spotify et l'enregistrement (effet, rééchantillonnage ou volume). Vérifiez les réglages audio."

# Recording
msgid "Finishing the last track…"
msgstr "Finalisation du dernier morceau…"

msgid "■  Stop recording"
msgstr "■  Arrêter l'enregistrement"

msgid "●  Start recording"
msgstr "●  Démarrer l'enregistrement"

msgid "This session · {} saved"
msgstr "Cette session · {} enregistrés"

msgid "Open folder"
msgstr "Ouvrir le dossier"

msgid "Waiting for the next track…"
msgstr "En attente du prochain morceau…"

msgid "Recorded tracks will appear here."
msgstr "Les morceaux enregistrés apparaîtront ici."

