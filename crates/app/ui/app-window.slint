import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, SpinBox } from "std-widgets.slint";

export enum SpotifyState { not-running, idle, playing, paused, ad }
export enum TrackState { waiting, recording, saved, discarded, already-recorded, failed }
/// Quality of a saved or discarded track, from the fidelity analysis.
export enum Quality { none, bit-perfect, near-transparent, peak-limited, processed, silent }
export enum Reason { none, partial, too-short, already-recorded }
export enum Warning { update, enhancements, sample-rate, processed, spotify-volume, spotify-fades, spotify-normalize, spotify-automix, spotify-not-lossless, cable-missing, cable-default, error }

export struct TrackRow {
    title: string,
    length: string,
    state: TrackState,
    quality: Quality,
    depth: int,
    touched: int,
    reason: Reason,
    tagged: bool,
    format: string,
}

export enum Failure { other, spotify-not-running, spotify-cli-missing, spotify-command, not-a-link, list-not-started, lost-spotify, capture-not-started, unknown-track, cable-routing, headset-playback, encoding, default-device }

export struct Notice {
    kind: Warning,
    /// For [`Warning.error`]: which situation.
    problem: Failure,
    /// The output device, for the setup warnings; for an error, what it
    /// is about (a track title).
    device: string,
    detail: string,
}

component Card inherits Rectangle {
    background: #ffffff;
    border-radius: 16px;
    border-width: 1px;
    border-color: #e5e9f0;
}

component QualityBadge inherits Rectangle {
    in property <TrackRow> track;
    property <string> label: root.track.state == TrackState.waiting ? ""
        : root.track.state == TrackState.recording ? @tr("recording…")
        : root.track.state == TrackState.already-recorded ? @tr("already recorded")
        : root.track.state == TrackState.failed ? @tr("error")
        : root.track.state == TrackState.discarded ? (
            root.track.reason == Reason.partial ? @tr("partial")
            : root.track.reason == Reason.too-short ? @tr("too short")
            : @tr("already recorded"))
        : root.track.quality == Quality.bit-perfect ? @tr("bit-perfect {}-bit", root.track.depth)
        : root.track.quality == Quality.near-transparent ? @tr("slightly changed by Spotify")
        : root.track.quality == Quality.peak-limited ? @tr("peaks limited by Spotify")
        : root.track.quality == Quality.processed ? @tr("altered")
        : root.track.format;
    property <color> tint: root.track.state == TrackState.recording ? #e5484d
        : root.track.state != TrackState.saved ? #8e8e93
        : root.track.quality == Quality.bit-perfect ? #16a34a
        : root.track.quality == Quality.processed ? #d97706
        : #0a84ff;
    visible: root.label != "";
    border-radius: 4px;
    background: tint.with-alpha(0.12);
    height: 20px;
    width: badge-text.preferred-width + 12px;
    badge-text := Text {
        text: root.label;
        color: root.tint.darker(0.2);
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component TrackLine inherits Rectangle {
    in property <TrackRow> track;
    height: 40px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Text {
            width: 16px;
            vertical-alignment: center;
            text: root.track.state == TrackState.waiting ? "○"
                : root.track.state == TrackState.recording ? "●"
                : root.track.state == TrackState.saved ? "✔"
                : root.track.state == TrackState.already-recorded ? "↷"
                : "✘";
            color: root.track.state == TrackState.recording ? #e5484d
                : root.track.state == TrackState.saved ? #16a34a
                : #8e8e93;
        }
        Text {
            text: root.track.title;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.track.state == TrackState.saved || root.track.state == TrackState.recording ? #1d1d1f : #6e6e73;
        }
        Text {
            text: root.track.length;
            vertical-alignment: center;
            color: #6e6e73;
            font-size: 12px;
        }
        VerticalLayout {
            alignment: center;
            QualityBadge { track: root.track; }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #0000000d;
    }
}

component SettingRow inherits VerticalLayout {
    alignment: start;
    vertical-stretch: 0;
    in property <string> label;
    spacing: 6px;
    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 600;
        wrap: word-wrap;
        color: #1d1d1f;
    }
    @children
}

/// A check box whose label wraps, with an optional explanation below.
component Option inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    spacing: 4px;
    alignment: start;
    CheckBox {
        enabled: root.enabled;
        checked <=> root.checked;
        toggled => { root.toggled(); }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        padding-top: 6px;
        Text {
            text: root.text;
            wrap: word-wrap;
            color: root.enabled ? #1d1d1f : #8e8e93;
            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }
        if root.hint != "": Text {
            text: root.hint;
            wrap: word-wrap;
            font-size: 11px;
            color: #8e8e93;
        }
    }
}

/// A light round button with a drawn cross: the "✕" glyph is missing from
/// the default font and showed as an empty square.
component CloseButton inherits Rectangle {
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: touch.has-hover ? #0000001a : transparent;
    Path {
        width: 12px;
        height: 12px;
        commands: "M 0 0 L 12 12 M 12 0 L 0 12";
        stroke: #1d1d1f;
        stroke-width: 1.6px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Section inherits VerticalLayout {
    alignment: start;
    vertical-stretch: 0;
    in property <string> title;
    spacing: 18px;
    Text {
        text: root.title;
        font-weight: 700;
        font-size: 13px;
        color: #6e6e73;
    }
    @children
}

export component AppWindow inherits Window {
    // Spotify
    in property <SpotifyState> spotify-state: SpotifyState.not-running;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <image> now-cover;
    in property <bool> has-cover;

    // Session
    in property <bool> recording;
    in property <bool> finishing;
    in property <string> elapsed: "00:00:00";
    in property <[TrackRow]> tracks;
    in property <[Notice]> notices;
    in property <int> saved-count;

    // Playlist mode
    in-out property <string> playlist-link;
    in property <bool> playlist-running;
    in property <string> playlist-name;
    in property <int> playlist-done;
    in property <int> playlist-total;
    /// Entries of the last playlist run not recorded.
    in property <int> missed-count;

    // Settings, written back by the panel
    in-out property <string> output-dir;
    in-out property <int> quality-index: 2;
    in-out property <int> format-index;
    in-out property <int> min-duration: 30;
    in-out property <bool> keep-partial;
    in-out property <int> folders-index;
    in-out property <int> prefix-index;
    in-out property <int> existing-index;
    in-out property <bool> skip-in-spotify;
    in-out property <bool> mute-ads: true;
    in-out property <bool> virtual-cable;
    in-out property <bool> listen;
    in-out property <bool> check-updates: true;
    in-out property <bool> lyrics: true;
    in-out property <int> language-index;
    /// The installed virtual cable, empty if none.
    in property <string> cable-name;

    callback toggle-recording();
    callback record-playlist();
    callback retry-missed();
    callback browse-output();
    callback open-output();
    callback open-cable-site();
    /// Makes the device `id` the Windows default again.
    callback restore-default-device(string);
    callback spotify-volume-max();
    callback open-url(string);

    /// An error, worded in the interface's language. `subject`: what it is
    /// about (a track title), when anything.
    pure function problem-text(problem: Failure, subject: string) -> string {
        return problem == Failure.spotify-not-running ? @tr("⚠ Spotify is not running: start it, then try again.")
            : problem == Failure.spotify-cli-missing ? @tr("⚠ Spotify's command-line tool (spotify_cli) is missing: playlist mode, exact tags and the volume check need a recent Spotify build.")
            : problem == Failure.spotify-command ? @tr("⚠ Spotify did not carry out the request.")
            : problem == Failure.not-a-link ? @tr("⚠ This is not a Spotify playlist, album or track link.")
            : problem == Failure.list-not-started ? @tr("⚠ Spotify did not start the playlist. Check that it is open and logged in, then try again.")
            : problem == Failure.lost-spotify ? @tr("⚠ Spotify stopped answering: the playlist was stopped.")
            : problem == Failure.capture-not-started ? @tr("⚠ The capture did not start: is Spotify running on this computer?")
            : problem == Failure.unknown-track ? @tr("⚠ Spotify does not know this track.")
            : problem == Failure.cable-routing ? @tr("⚠ Spotify could not be sent to the virtual cable: it stays on its device.")
            : problem == Failure.headset-playback ? @tr("⚠ Spotify could not be played back on the headset.")
            : problem == Failure.encoding ? @tr("⚠ \"{}\" could not be saved.", subject)
            : problem == Failure.default-device ? @tr("⚠ The default output device could not be changed.")
            : @tr("⚠ Something went wrong.");
    }
    callback quality-changed(int);
    callback settings-changed();
    callback language-changed(int);

    in-out property <bool> settings-open;
    in-out property <int> settings-tab;
    property <bool> show-audio-help;

    title: "Resona";
    icon: @image-url("../assets/icon.png");
    min-width: 460px;
    min-height: 620px;
    preferred-width: 560px;
    preferred-height: 720px;
    background: #f3f5f9;
    default-font-size: 13px;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Header
        HorizontalLayout {
            Text {
                text: "Resona";
                font-size: 24px;
                font-weight: 800;
                color: #1d1d1f;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("⚙ Settings");
                clicked => { root.settings-open = true; }
            }
        }

        // Now playing
        Card {
            min-height: 112px;
            HorizontalLayout {
                padding: 14px;
                spacing: 14px;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: 6px;
                    background: root.spotify-state == SpotifyState.playing ? #2563eb26 : #0000000d;
                    clip: true;
                    property <bool> cover-shown: root.has-cover && (root.spotify-state == SpotifyState.playing || root.spotify-state == SpotifyState.paused);
                    if cover-shown: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.now-cover;
                        image-fit: cover;
                    }
                    if !cover-shown: Text {
                        text: root.spotify-state == SpotifyState.ad ? "AD" : "♪";
                        font-size: 26px;
                        color: #6e6e73;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: root.spotify-state == SpotifyState.not-running ? @tr("Spotify is not running")
                            : root.spotify-state == SpotifyState.ad ? @tr("Advertisement")
                            : root.now-title == "" ? @tr("Nothing playing")
                            : root.now-title;
                        font-size: 16px;
                        font-weight: 700;
                        overflow: elide;
                        color: #1d1d1f;
                    }
                    Text {
                        text: root.now-album == "" ? root.now-artist : root.now-artist + " · " + root.now-album;
                        visible: root.now-title != "" && root.spotify-state != SpotifyState.ad;
                        overflow: elide;
                        color: #6e6e73;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.spotify-state == SpotifyState.playing ? @tr("▶ Playing")
                                : root.spotify-state == SpotifyState.paused ? (root.recording ? @tr("⏸ Paused: press play in Spotify") : @tr("⏸ Paused"))
                                : root.spotify-state == SpotifyState.ad ? @tr("Ad, not recorded")
                                : root.spotify-state == SpotifyState.idle ? (root.recording ? @tr("Play something in Spotify") : @tr("Spotify is open"))
                                : @tr("Start Spotify to record");
                            color: #6e6e73;
                            font-size: 12px;
                        }
                        Text {
                            visible: root.recording;
                            text: "● REC " + root.elapsed;
                            color: #e5484d;
                            font-size: 12px;
                            font-weight: 700;
                        }
                    }
                }
            }
        }

        // Notices
        for notice in root.notices: Rectangle {
            background: notice.kind == Warning.error ? #ffe5e5 : #fff4e5;
            border-radius: 8px;
            VerticalLayout {
                padding: 8px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                Text {
                    wrap: word-wrap;
                    color: notice.kind == Warning.error ? #a40000 : #8a4b00;
                    text: notice.kind == Warning.enhancements ? @tr("⚠ Windows audio enhancements may be on for \"{}\": recordings would not be lossless. Settings → Sound → that device → Audio enhancements → Off.", notice.device)
                        : notice.kind == Warning.sample-rate ? @tr("⚠ \"{}\" runs at {} Hz. Set it to 44100 Hz (Settings → Sound → that device → Format) for lossless recordings.", notice.device, notice.detail)
                        : notice.kind == Warning.cable-missing ? @tr("⚠ No virtual cable installed: Spotify stays on its device. Install VB-Cable or turn the option off in the settings.")
                        : notice.kind == Warning.spotify-fades ? @tr("⚠ \"{}\" starts with a fade Spotify added: crossfade or Automix is on, and track changes are not lossless. Spotify → Settings → Playback → turn Crossfade and Automix off.", notice.detail)
                        : notice.kind == Warning.spotify-normalize ? @tr("⚠ Spotify's volume normalization is on: it changes the sound. Spotify → Settings → Playback → Normalize volume → off.")
                        : notice.kind == Warning.spotify-automix ? @tr("⚠ Spotify's Automix is on: it mixes the transitions of playlists. Spotify → Settings → Playback → Automix → off.")
                        : notice.kind == Warning.spotify-not-lossless ? @tr("⚠ Spotify does not stream in Lossless. Spotify → Settings → Audio quality → Lossless, or set the Spotify quality in Resona's settings.")
                        : notice.kind == Warning.cable-default ? @tr("⚠ The virtual cable is the Windows default output device: nothing can be heard.")
                        : notice.kind == Warning.processed ? @tr("⚠ Tracks altered on their way out of Spotify: {} (last: \"{}\"). Check Spotify's volume and the audio settings.", notice.device, notice.detail)
                        : notice.kind == Warning.spotify-volume ? @tr("⚠ Spotify's volume is at {} %: recordings are scaled down and not lossless.", notice.detail)
                        : notice.kind == Warning.update ? @tr("Resona {} is available.", notice.device)
                        : notice.kind == Warning.error ? root.problem-text(notice.problem, notice.device) + (notice.detail == "" ? "" : " (" + notice.detail + ")")
                        : notice.detail;
                }
                if notice.kind == Warning.cable-default && notice.device != "": Text {
                    text: @tr("Use \"{}\" again", notice.device);
                    color: #0a84ff;
                    font-weight: 700;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.restore-default-device(notice.detail); }
                    }
                }
                if notice.kind == Warning.update: Text {
                    text: @tr("Download it");
                    color: #0a84ff;
                    font-weight: 700;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-url(notice.detail); }
                    }
                }
                if notice.kind == Warning.spotify-volume: Text {
                    text: @tr("Set Spotify to 100 %");
                    color: #0a84ff;
                    font-weight: 700;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.spotify-volume-max(); }
                    }
                }
            }
        }

        // Playlist or album link
        if !root.recording: HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: @tr("Spotify playlist or album link");
                text <=> root.playlist-link;
                horizontal-stretch: 1;
                accepted => { root.record-playlist(); }
            }
            Button {
                text: @tr("Record it");
                enabled: root.playlist-link != "";
                clicked => { root.record-playlist(); }
            }
        }

        // Record button
        Rectangle {
            height: 48px;
            border-radius: 12px;
            background: root.finishing ? #c7c7cc
                : root.recording ? (touch.has-hover ? #d13438 : #e5484d)
                // The logo's blue. (No gradient: the software renderer then
                // loses the rounded corners.)
                : (touch.has-hover ? #1d4ed8 : #2563eb);
            Text {
                text: root.finishing ? @tr("Finishing the last track…")
                    : root.playlist-running ? @tr("■  Stop the playlist")
                    : root.recording ? @tr("■  Stop recording")
                    : @tr("●  Start recording");
                color: white;
                font-size: 15px;
                font-weight: 700;
            }
            touch := TouchArea {
                enabled: !root.finishing;
                mouse-cursor: pointer;
                clicked => { root.toggle-recording(); }
            }
        }

        // Session
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Text {
                        text: root.playlist-name != ""
                            ? @tr("{} · {} / {}", root.playlist-name, root.playlist-done, root.playlist-total)
                            : @tr("This session · {} saved", root.saved-count);
                        font-weight: 700;
                        color: #1d1d1f;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if !root.recording && root.missed-count > 0: Text {
                        text: @tr("Retry the {} missed", root.missed-count);
                        color: #0a84ff;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.retry-missed(); }
                        }
                    }
                    Text {
                        text: @tr("Open folder");
                        color: #0a84ff;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-output(); }
                        }
                    }
                }
                if root.tracks.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 56px;
                            height: 56px;
                            border-radius: 18px;
                            background: #edf2ff;
                            Text {
                                text: "♫";
                                color: #2563eb;
                                font-size: 26px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: root.recording ? @tr("Waiting for the next track…") : @tr("Your music, saved here");
                        font-size: 16px;
                        font-weight: 600;
                        color: #334155;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: @tr("Recorded tracks will appear here.");
                        font-size: 12px;
                        color: #6e6e73;
                        horizontal-alignment: center;
                    }
                }
                if root.tracks.length > 0: ListView {
                    vertical-stretch: 1;
                    for row in root.tracks: TrackLine { track: row; }
                }
            }
        }

        Text {
            text: root.output-dir;
            color: #8e8e93;
            font-size: 11px;
            overflow: elide;
        }
    }


    if root.settings-open: Rectangle {
        background: #f3f5f9;
        VerticalLayout {
            padding: 24px;
            spacing: 18px;
            HorizontalLayout {
                Text {
                    text: @tr("Settings");
                    font-size: 24px;
                    font-weight: 800;
                    color: #1d1d1f;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                CloseButton { clicked => { root.settings-open = false; } }
            }
            HorizontalLayout {
                spacing: 6px;
                for label[index] in [@tr("Recording"), @tr("Files"), @tr("Audio"), @tr("Interface")]: Button {
                    text: label;
                    horizontal-stretch: 1;
                    checked: root.settings-tab == index;
                    clicked => {
                        root.settings-tab = index;
                        scroll.content-y = 0px;
                    }
                }
            }
            Card {
                vertical-stretch: 1;
                scroll := ScrollView {
                    x: 18px;
                    y: 18px;
                    width: parent.width - 36px;
                    height: parent.height - 36px;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: scroll.visible-width;
                        padding-right: 14px;
                        alignment: start;
                        spacing: 22px;
                        if root.settings-tab == 0: Section {
                            title: @tr("Recording");
                            SettingRow {
                                label: @tr("Folder");
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text: root.output-dir;
                                        read-only: true;
                                        horizontal-stretch: 1;
                                    }
                                    Button {
                                        text: "…";
                                        clicked => { root.browse-output(); }
                                    }
                                }
                            }
                            SettingRow {
                                label: @tr("Spotify quality");
                                ComboBox {
                                    model: [@tr("Free (160 kbps)"), @tr("Premium (320 kbps)"), @tr("Lossless (FLAC)")];
                                    current-index <=> root.quality-index;
                                    horizontal-stretch: 1;
                                    selected => { root.quality-changed(self.current-index); }
                                }
                            }
                            SettingRow {
                                label: @tr("Format");
                                ComboBox {
                                    model: [
                                        @tr("FLAC, depth of the source"), "FLAC 16-bit", "FLAC 24-bit",
                                        @tr("WAV, depth of the source"), "WAV 16-bit", "WAV 24-bit",
                                        "MP3 320 kbps", "MP3 256 kbps", "MP3 192 kbps", "MP3 160 kbps", "MP3 128 kbps",
                                    ];
                                    current-index <=> root.format-index;
                                    horizontal-stretch: 1;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: @tr("Shortest track kept (s)");
                                SpinBox {
                                    minimum: 0;
                                    maximum: 600;
                                    value <=> root.min-duration;
                                    horizontal-stretch: 1;
                                    edited => { root.settings-changed(); }
                                }
                            }
                            Option {
                                text: @tr("Keep incomplete tracks");
                                hint: @tr("Started before the recording, or skipped before the end.");
                                checked <=> root.keep-partial;
                                toggled => { root.settings-changed(); }
                            }
                        }

                        if root.settings-tab == 1: Section {
                            title: @tr("Files");
                            SettingRow {
                                label: @tr("Sub-folders");
                                ComboBox {
                                    model: [@tr("None"), @tr("Artist"), @tr("Artist / Album")];
                                    current-index <=> root.folders-index;
                                    horizontal-stretch: 1;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: @tr("Before the name");
                                ComboBox {
                                    model: [@tr("Nothing"), @tr("Track number (04)"), @tr("Recording order (001)")];
                                    current-index <=> root.prefix-index;
                                    horizontal-stretch: 1;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                label: @tr("Already recorded");
                                ComboBox {
                                    model: [@tr("Skip it"), @tr("Replace it"), @tr("Keep both")];
                                    current-index <=> root.existing-index;
                                    horizontal-stretch: 1;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            Option {
                                text: @tr("Make Spotify skip tracks already recorded");
                                enabled: root.existing-index == 0;
                                checked <=> root.skip-in-spotify;
                                toggled => { root.settings-changed(); }
                            }
                            Option {
                                text: @tr("Save lyrics next to each track (.lrc)");
                                hint: @tr("From LRCLIB, an open lyrics database: synced when it has the timing, plain otherwise.");
                                checked <=> root.lyrics;
                                toggled => { root.settings-changed(); }
                            }
                        }

                        if root.settings-tab == 2: Section {
                            title: @tr("Audio output");
                            Option {
                                text: @tr("Play Spotify through a virtual cable");
                                hint: root.cable-name == ""
                                    ? @tr("Install VB-Cable to isolate recordings from your headset settings.")
                                    : @tr("Records independently of your headset. Enable monitoring below to listen.");
                                enabled: root.cable-name != "" || root.virtual-cable;
                                checked <=> root.virtual-cable;
                                toggled => { root.settings-changed(); }
                            }
                            Option {
                                text: @tr("Hear Spotify while recording");
                                enabled: root.virtual-cable;
                                checked <=> root.listen;
                                toggled => { root.settings-changed(); }
                            }
                            if root.cable-name == "": Text {
                                text: @tr("Get VB-Cable…");
                                color: #0a84ff;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-cable-site(); }
                                }
                            }
                        }

                        if root.settings-tab == 2: Section {
                            title: @tr("Ads (Spotify Free)");
                            Option {
                                text: @tr("Mute Spotify during ads");
                                checked <=> root.mute-ads;
                                toggled => { root.settings-changed(); }
                            }
                        }

                        if root.settings-tab == 3: Section {
                            title: @tr("Interface");
                            SettingRow {
                                label: @tr("Language");
                                ComboBox {
                                    model: ["Français", "English"];
                                    current-index <=> root.language-index;
                                    horizontal-stretch: 1;
                                    selected => { root.language-changed(self.current-index); }
                                }
                            }
                            Option {
                                text: @tr("Check for updates at launch");
                                checked <=> root.check-updates;
                                toggled => { root.settings-changed(); }
                            }
                        }

                        if root.settings-tab == 2: Button {
                            text: root.show-audio-help ? @tr("Hide audio tips") : @tr("Tips for lossless audio");
                            clicked => { root.show-audio-help = !root.show-audio-help; }
                        }
                        if root.settings-tab == 2 && root.show-audio-help: Text {
                            text: @tr("For lossless recordings: Spotify in Lossless quality, its volume at maximum, normalization, equalizer, crossfade and Automix off; Windows audio enhancements off and the output device at 44100 Hz. Each saved track says whether it came out bit-perfect.");
                            wrap: word-wrap;
                            color: #6e6e73;
                            font-size: 12px;
                        }

                    }
                }
            }
            Text {
                text: @tr("Changes are saved automatically");
                color: #6e6e73;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}
